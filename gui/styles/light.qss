/* XRD Phase Matcher — Light Lab theme */

* {
    font-family: "Helvetica Neue", "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QWidget {
    background-color: #F5F7FA;
    color: #1A2332;
}

QMenuBar {
    background-color: #EEF1F6;
    color: #1A2332;
    border-bottom: 1px solid #C5CDD8;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #D8DEE8;
}

QMenu {
    background-color: #FFFFFF;
    color: #1A2332;
    border: 1px solid #C5CDD8;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #1B6B7A;
    color: #FFFFFF;
}

QToolBar {
    background-color: #EEF1F6;
    border-bottom: 1px solid #C5CDD8;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #1A2332;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
}

QToolBar QToolButton:hover {
    background-color: #D8DEE8;
    border-color: #C5CDD8;
}

QToolBar QToolButton:pressed {
    background-color: #C5CDD8;
}

QStatusBar {
    background-color: #EEF1F6;
    color: #5A6A7A;
    border-top: 1px solid #C5CDD8;
}

QTabWidget::pane {
    border: 1px solid #C5CDD8;
    background-color: #FFFFFF;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #EEF1F6;
    color: #5A6A7A;
    border: 1px solid #C5CDD8;
    border-bottom: none;
    padding: 7px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 80px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1A2332;
    font-weight: 600;
    border-bottom: 2px solid #1B6B7A;
}

QTabBar::tab:hover:!selected {
    background-color: #E4E9F0;
    color: #1A2332;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #C5CDD8;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #1B6B7A;
    background-color: #FFFFFF;
}

QPushButton {
    background-color: #EEF1F6;
    color: #1A2332;
    border: 1px solid #C5CDD8;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #E4E9F0;
    border-color: #A8B4C4;
}

QPushButton:pressed {
    background-color: #D8DEE8;
}

QPushButton:disabled {
    color: #8A9BB0;
    background-color: #F5F7FA;
    border-color: #D8DEE8;
}

QPushButton#primaryButton {
    background-color: #1B6B7A;
    color: #FFFFFF;
    border: 1px solid #155A66;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #155A66;
}

QPushButton#primaryButton:pressed {
    background-color: #0F4852;
}

QPushButton#primaryButton:disabled {
    background-color: #A8C5CB;
    border-color: #A8C5CB;
    color: #EEF1F6;
}

QPushButton#dangerButton {
    background-color: #F8EAEA;
    color: #B33A3A;
    border: 1px solid #E0B0B0;
}

QPushButton#dangerButton:hover {
    background-color: #F0D8D8;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1A2332;
    border: 1px solid #C5CDD8;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #1B6B7A;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #1B6B7A;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled,
QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #F5F7FA;
    color: #8A9BB0;
    border-color: #D8DEE8;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1A2332;
    border: 1px solid #C5CDD8;
    selection-background-color: #1B6B7A;
    selection-color: #FFFFFF;
}

QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F5F7FA;
    color: #1A2332;
    gridline-color: #D8DEE8;
    border: 1px solid #C5CDD8;
    border-radius: 4px;
    selection-background-color: #1B6B7A;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #EEF1F6;
    color: #2D3748;
    border: none;
    border-right: 1px solid #C5CDD8;
    border-bottom: 1px solid #C5CDD8;
    padding: 6px 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #F5F7FA;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C5CDD8;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #A8B4C4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F5F7FA;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #C5CDD8;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSplitter::handle {
    background-color: #C5CDD8;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QProgressBar {
    border: 1px solid #C5CDD8;
    border-radius: 4px;
    background-color: #EEF1F6;
    text-align: center;
    color: #1A2332;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #1B6B7A;
    border-radius: 3px;
}

QCheckBox, QRadioButton, QLabel {
    color: #1A2332;
}

QLabel#mutedLabel, QLabel.statusMuted {
    color: #5A6A7A;
    font-style: italic;
}

QLabel#statusOkLabel, QLabel.statusOk {
    color: #2A7A4B;
    font-weight: 600;
    font-style: normal;
}

QLabel#statusWarnLabel, QLabel.statusWarn {
    color: #B36B00;
    font-style: italic;
}

QLabel#statusErrorLabel, QLabel.statusError {
    color: #B33A3A;
}

QToolTip {
    background-color: #1A2332;
    color: #FFFFFF;
    border: none;
    padding: 4px 8px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QPushButton#collapsibleHeader {
    text-align: left;
    padding: 6px 10px;
    background-color: #EEF1F6;
    border: 1px solid #C5CDD8;
    border-radius: 4px;
    font-weight: 600;
}

QPushButton#collapsibleHeader:hover {
    background-color: #E2E7EF;
}

QPushButton#collapsibleHeader:checked {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QFrame#collapsibleBody {
    border: 1px solid #C5CDD8;
    border-top: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #FFFFFF;
}

QToolBox::tab {
    background-color: #EEF1F6;
    border: 1px solid #C5CDD8;
    border-radius: 4px;
    padding: 8px 10px;
    color: #5A6A7A;
}

QToolBox::tab:selected {
    color: #1B6B7A;
    font-weight: 600;
}
