/* XRD Phase Matcher — Dark Instrument theme */

* {
    font-family: "Helvetica Neue", "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QWidget {
    background-color: #1A1F26;
    color: #E8EDF4;
}

QMenuBar {
    background-color: #222831;
    color: #E8EDF4;
    border-bottom: 1px solid #3A4553;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #2A313C;
}

QMenu {
    background-color: #222831;
    color: #E8EDF4;
    border: 1px solid #3A4553;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #4ECDC4;
    color: #1A1F26;
}

QToolBar {
    background-color: #222831;
    border-bottom: 1px solid #3A4553;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #E8EDF4;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
}

QToolBar QToolButton:hover {
    background-color: #2A313C;
    border-color: #3A4553;
}

QToolBar QToolButton:pressed {
    background-color: #3A4553;
}

QStatusBar {
    background-color: #222831;
    color: #8A9BB0;
    border-top: 1px solid #3A4553;
}

QTabWidget::pane {
    border: 1px solid #3A4553;
    background-color: #222831;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #1A1F26;
    color: #8A9BB0;
    border: 1px solid #3A4553;
    border-bottom: none;
    padding: 7px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 80px;
}

QTabBar::tab:selected {
    background-color: #222831;
    color: #E8EDF4;
    font-weight: 600;
    border-bottom: 2px solid #4ECDC4;
}

QTabBar::tab:hover:!selected {
    background-color: #2A313C;
    color: #E8EDF4;
}

QGroupBox {
    background-color: #222831;
    border: 1px solid #3A4553;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #4ECDC4;
    background-color: #222831;
}

QPushButton {
    background-color: #2A313C;
    color: #E8EDF4;
    border: 1px solid #3A4553;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #343C48;
    border-color: #4A5568;
}

QPushButton:pressed {
    background-color: #3A4553;
}

QPushButton:disabled {
    color: #5A6A7A;
    background-color: #1A1F26;
    border-color: #2A313C;
}

QPushButton#primaryButton {
    background-color: #4ECDC4;
    color: #1A1F26;
    border: 1px solid #3DB8B0;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #3DB8B0;
}

QPushButton#primaryButton:pressed {
    background-color: #2FA39B;
}

QPushButton#primaryButton:disabled {
    background-color: #2A4A4A;
    border-color: #2A4A4A;
    color: #5A6A7A;
}

QPushButton#dangerButton {
    background-color: #3A2A2A;
    color: #E06C6C;
    border: 1px solid #5A3A3A;
}

QPushButton#dangerButton:hover {
    background-color: #4A3232;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #1A1F26;
    color: #E8EDF4;
    border: 1px solid #3A4553;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #4ECDC4;
    selection-color: #1A1F26;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #4ECDC4;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #222831;
    color: #E8EDF4;
    border: 1px solid #3A4553;
    selection-background-color: #4ECDC4;
    selection-color: #1A1F26;
}

QTableWidget, QTableView {
    background-color: #222831;
    alternate-background-color: #1A1F26;
    color: #E8EDF4;
    gridline-color: #3A4553;
    border: 1px solid #3A4553;
    border-radius: 4px;
    selection-background-color: #4ECDC4;
    selection-color: #1A1F26;
}

QHeaderView::section {
    background-color: #2A313C;
    color: #C8D0DC;
    border: none;
    border-right: 1px solid #3A4553;
    border-bottom: 1px solid #3A4553;
    padding: 6px 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #1A1F26;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3A4553;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4A5568;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1A1F26;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #3A4553;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSplitter::handle {
    background-color: #3A4553;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QProgressBar {
    border: 1px solid #3A4553;
    border-radius: 4px;
    background-color: #2A313C;
    text-align: center;
    color: #E8EDF4;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #4ECDC4;
    border-radius: 3px;
}

QCheckBox, QRadioButton, QLabel {
    color: #E8EDF4;
}

QLabel#mutedLabel, QLabel.statusMuted {
    color: #8A9BB0;
    font-style: italic;
}

QLabel#statusOkLabel, QLabel.statusOk {
    color: #5CB87A;
    font-weight: 600;
    font-style: normal;
}

QLabel#statusWarnLabel, QLabel.statusWarn {
    color: #E0A040;
    font-style: italic;
}

QLabel#statusErrorLabel, QLabel.statusError {
    color: #E06C6C;
}

QToolTip {
    background-color: #E8EDF4;
    color: #1A1F26;
    border: none;
    padding: 4px 8px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QPushButton#stageComplete {
    border-left: 3px solid #5CB87A;
}

QPushButton#stagePending {
    border-left: 3px solid transparent;
}

QToolBox::tab {
    background-color: #2A313C;
    border: 1px solid #3A4553;
    border-radius: 4px;
    padding: 6px 10px;
    color: #8A9BB0;
}

QToolBox::tab:selected {
    color: #4ECDC4;
    font-weight: 600;
}
